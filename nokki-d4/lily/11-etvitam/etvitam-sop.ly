\language "english"

etvitam-sop = \relative c'' {
  \clef treble
  %\clef soprano
  \key d \major
  \vocal

  %283
  \etvitam-start
  R1

  %284
  a2 b4( cs)

  %285
  d8[ b] e[ d] cs[ a] d4

  %286
  d8[ cs16 b] cs4 d8 a'[ g fs]

  %287
  e[ d] cs b a[ g] fs d'(~

  %288
  d4 cs2) b8 b

  %289
  b4( a2 g4)

  %290
  g r8 a\melisma b[ cs16 d] e8[ fs16 g]

  %291
  a,8[ b16 cs] d8[ e16 fs] g,8[ a16 b] cs8[ d16 e]

  %292
  fs,8[ g16 a] b8[ cs16 d] e,8[ fs16 g] a8[ b16 cs]

  %293
  fs,8[ e] fs4\melismaEnd e r8 fs'

  %294
  e[ fs] cs d e[ d cs] d

  %295
  d4( cs2) b8 b

  %296
  b4( a2 g4)

  %297
  g r8 a'( g[ fs e d]

  %298
  cs[ b]) a fs'( e[ d cs b]

  %299
  a[ g]) fs d' d r cs r

  %300
  d r e r d r cs r

  %301
  d4 r r2
  \bar "|."
}

etvitam-sop-words = \lyricmode {
  %284
  Et vi -- tam __ ven -- tu -- ri sae -- cu -- li,
  Et __ vi -- tam ven -- tu -- ri sae -- cu -- li.

  %289
  A -- men, a -- men. Et

  %294
  vi -- tam ven -- tu -- ri sae -- cu -- li.
  A -- men, a -- men, a -- men, a -- men, a --

  %300
  men, a -- men, a -- men.
}
